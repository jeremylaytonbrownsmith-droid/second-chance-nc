// Second Chance Pet Adoptions — Auction and Giving System
// Phase 1 data model. See CLAUDE.md for the hard rules this schema follows:
// integer cents everywhere, soft delete only, audit rows on money mutations.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum EventStatus {
  DRAFT
  OPEN
  CLOSED
  ARCHIVED
}

enum RegistrationStatus {
  REGISTERED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
}

enum AuctionItemType {
  SILENT
  LIVE
  RAFFLE
  FIXED_PRICE
  FUND_A_NEED
}

enum AuctionItemStatus {
  DRAFT
  OPEN
  CLOSED
  AWARDED
  UNSOLD
}

enum BidSource {
  MOBILE
  PAPER
  AUCTIONEER
}

// Matches the real workflow vocabulary observed in the client's own
// multi-year outreach spreadsheet (2,800+ rows), not an idealized guess —
// their "Status" column collapses to roughly these six buckets, plus a
// DO_NOT_CONTACT suppression state that's distinct from a plain decline
// (a closed business or a relationship the org doesn't want re-approached).
enum SolicitationStatus {
  PROSPECT // not yet contacted
  CONTACTED // emailed / called / dropped off a flyer / online form — awaiting reply
  COMMITTED // said yes, item not physically in hand yet
  DONATED // item received
  DECLINED // said no, business closed, email bounced — detail goes in notes
  DO_NOT_CONTACT // suppression flag; skip on future asks regardless of year
}

enum SolicitationDeliveryMethod {
  MAIL
  PICKUP
  DROPOFF
  DIGITAL
}

enum TransactionStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  WRITTEN_OFF
}

enum TransactionMethod {
  CARD
  CASH
  CHECK
  IN_KIND
}

// Deductible calculation depends on this. See CLAUDE.md / Section 5 table.
// Do not add a line type without updating src/lib/money/deductible.ts and
// its tests in the same change.
enum TransactionLineType {
  AUCTION_WIN
  RAFFLE
  FUND_A_NEED
  CASH_GIFT
  TICKET
  SPONSORSHIP
  MERCH
}

enum ReceiptType {
  QUID_PRO_QUO
  ANNUAL_STATEMENT
  IN_KIND
}

enum SyncEntityType {
  CONSTITUENT
  GIFT
}

enum SyncStatus {
  PENDING
  SUCCESS
  FAILED
}

// ---------------------------------------------------------------------------
// Core organization / event
// ---------------------------------------------------------------------------

model Organization {
  id              String  @id @default(cuid())
  name            String
  ein             String?
  fiscalYearStart Int     @default(1) // month, 1-12

  // Marks this org (and everything under it) as demo/simulation data —
  // Section 14. Never mixed with real donor data; the UI banners any
  // screen scoped to a demo org and email sending is restricted.
  isDemo Boolean @default(false)

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  voidedAt   DateTime?
  voidReason String?

  events       Event[]
  constituents Constituent[]

  @@map("organizations")
}

model Event {
  id           String       @id @default(cuid())
  orgId        String
  organization Organization @relation(fields: [orgId], references: [id])

  name      String
  eventDate DateTime
  taxYear   Int
  status    EventStatus @default(DRAFT)

  silentCloseAt DateTime?
  settingsJson  Json?

  // Denormalized from Organization.isDemo at creation time so demo-mode
  // checks (banner, reset control, restricted email sending) don't need
  // an extra join on every page render.
  isDemo Boolean @default(false)

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  voidedAt   DateTime?
  voidReason String?

  registrations Registration[]
  itemDonors    ItemDonor[]
  auctionItems  AuctionItem[]
  transactions  Transaction[]
  solicitations Solicitation[]

  @@index([orgId])
  @@map("events")
}

// ---------------------------------------------------------------------------
// People
// ---------------------------------------------------------------------------

model Constituent {
  id           String       @id @default(cuid())
  orgId        String
  organization Organization @relation(fields: [orgId], references: [id])

  firstName  String?
  lastName   String?
  orgName    String? // set when isBusiness
  isBusiness Boolean @default(false)

  email      String?
  phone      String?
  address1   String?
  address2   String?
  city       String?
  state      String?
  postalCode String?
  country    String?

  etapestryAccountRef String?
  notes               String?

  mergedIntoId String?
  mergedInto   Constituent?  @relation("ConstituentMerge", fields: [mergedIntoId], references: [id])
  mergedFrom   Constituent[] @relation("ConstituentMerge")

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  voidedAt   DateTime?
  voidReason String?

  registrations Registration[]
  itemDonors    ItemDonor[]
  receipts      Receipt[]

  @@index([orgId])
  @@index([orgId, email])
  @@index([orgId, lastName, firstName])
  @@map("constituents")
}

model Registration {
  id            String      @id @default(cuid())
  eventId       String
  event         Event       @relation(fields: [eventId], references: [id])
  constituentId String
  constituent   Constituent @relation(fields: [constituentId], references: [id])

  bidderNumber    Int
  tableAssignment String?
  checkedInAt     DateTime?

  // Processor tokens ONLY. Never store card numbers here or anywhere else.
  paymentCustomerRef String?
  paymentMethodRef   String?

  status RegistrationStatus @default(REGISTERED)

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  voidedAt   DateTime?
  voidReason String?

  bids         Bid[]
  awards       Award[]
  transactions Transaction[]

  @@unique([eventId, bidderNumber])
  @@index([eventId, constituentId])
  @@map("registrations")
}

// ---------------------------------------------------------------------------
// Solicitation tracking — the "who have we asked, what have we gotten"
// list that exists before an item is ever donated. Deliberately lightweight
// (a name/contact, not a full Constituent) since most asks never convert;
// once one is marked DONATED it produces a real ItemDonor + AuctionItem.
// ---------------------------------------------------------------------------

model Solicitation {
  id      String @id @default(cuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id])

  contactName         String
  contactEmail        String?
  contactPhone        String?
  // Free-text, often comma-separated tags in real use (e.g. "Lodging,
  // Mountains") rather than a single value — category search matches
  // against any one of them, not just an exact string.
  category            String?
  notes               String?
  estimatedValueCents Int?

  status         SolicitationStatus          @default(PROSPECT)
  deliveryMethod SolicitationDeliveryMethod?

  // Who on the team is working this ask, and when they last touched it —
  // "Solicitor" and "Date Solicited/Followed Up" in the real spreadsheet.
  assignedTo      String?
  lastContactedAt DateTime?

  // Did this contact give in a recent prior year? Lets a solicitor spot a
  // reliable repeat donor (or someone worth re-approaching) without a full
  // cross-event giving history, which is a bigger feature than this needs.
  priorYearDonor Boolean @default(false)

  fulfilledAuctionItemId String?      @unique
  fulfilledAuctionItem   AuctionItem? @relation(fields: [fulfilledAuctionItemId], references: [id])

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  voidedAt   DateTime?
  voidReason String?

  @@index([eventId, status])
  @@index([eventId, category])
  @@map("solicitations")
}

// ---------------------------------------------------------------------------
// Item donors / non-cash gift tracking (8283 / 8282)
// ---------------------------------------------------------------------------

model ItemDonor {
  id            String      @id @default(cuid())
  eventId       String
  event         Event       @relation(fields: [eventId], references: [id])
  constituentId String
  constituent   Constituent @relation(fields: [constituentId], references: [id])

  claimedValueCents    Int
  // true when claimedValueCents > $500 — see substantiation.ts
  substantiationNeeded Boolean @default(false)

  form8283ReceivedAt DateTime?
  form8282DueAt      DateTime?
  form8282FiledAt    DateTime?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  voidedAt   DateTime?
  voidReason String?

  auctionItems AuctionItem[]

  @@index([eventId, constituentId])
  @@map("item_donors")
}

// ---------------------------------------------------------------------------
// Auction catalog
// ---------------------------------------------------------------------------

model AuctionItem {
  id      String @id @default(cuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id])

  itemNumber  String
  title       String
  description String?
  category    String?
  itemType    AuctionItemType

  // REQUIRED before status can move to OPEN. See CLAUDE.md rule 1.
  fmvCents Int?
  fmvBasis String?

  startingBidCents  Int?
  bidIncrementCents Int?
  buyNowCents       Int?
  quantity          Int  @default(1)

  itemDonorId String?
  itemDonor   ItemDonor? @relation(fields: [itemDonorId], references: [id])

  closeAt DateTime?
  status  AuctionItemStatus @default(DRAFT)

  images String[] @default([])

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  voidedAt   DateTime?
  voidReason String?

  bids         Bid[]
  awards       Award[]
  solicitation Solicitation?

  @@unique([eventId, itemNumber])
  @@index([eventId, status])
  @@map("auction_items")
}

model Bid {
  id             String       @id @default(cuid())
  itemId         String
  item           AuctionItem  @relation(fields: [itemId], references: [id])
  registrationId String
  registration   Registration @relation(fields: [registrationId], references: [id])

  amountCents Int
  placedAt    DateTime  @default(now())
  source      BidSource
  isMaxBid    Boolean   @default(false)

  voidedAt   DateTime?
  voidReason String?

  @@index([itemId, amountCents])
  @@index([registrationId])
  @@map("bids")
}

model Award {
  id             String       @id @default(cuid())
  itemId         String
  item           AuctionItem  @relation(fields: [itemId], references: [id])
  registrationId String
  registration   Registration @relation(fields: [registrationId], references: [id])

  amountCents Int
  awardedAt   DateTime @default(now())

  voidedAt   DateTime?
  voidReason String?

  transactionLines TransactionLine[]

  @@index([itemId])
  @@index([registrationId])
  @@map("awards")
}

// ---------------------------------------------------------------------------
// Money: transactions, lines, receipts
// ---------------------------------------------------------------------------

model Transaction {
  id             String       @id @default(cuid())
  registrationId String
  registration   Registration @relation(fields: [registrationId], references: [id])
  eventId        String
  event          Event        @relation(fields: [eventId], references: [id])

  totalCents   Int
  processor    String?
  processorRef String?
  status       TransactionStatus  @default(PENDING)
  paidAt       DateTime?
  method       TransactionMethod?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  voidedAt   DateTime?
  voidReason String?

  lines TransactionLine[]

  @@index([registrationId])
  @@index([eventId, status])
  @@map("transactions")
}

model TransactionLine {
  id            String      @id @default(cuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id])

  lineType TransactionLineType

  // Nullable: pure gifts (FUND_A_NEED, CASH_GIFT) have no auction reference.
  awardId String?
  award   Award?  @relation(fields: [awardId], references: [id])

  amountCents     Int // what they paid
  fmvCents        Int @default(0) // value of goods/services received
  deductibleCents Int // computed — see src/lib/money/deductible.ts, never write this by hand

  designation String?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  voidedAt   DateTime?
  voidReason String?

  @@index([transactionId])
  @@map("transaction_lines")
}

model Receipt {
  id            String      @id @default(cuid())
  constituentId String
  constituent   Constituent @relation(fields: [constituentId], references: [id])

  receiptType ReceiptType
  eventId     String?
  taxYear     Int?

  generatedAt DateTime  @default(now())
  sentAt      DateTime?
  pdfKey      String?

  // Receipts are immutable. A correction creates a new Receipt row that
  // voids this one by reference — never edit a sent receipt in place.
  voidOfReceiptId String?
  voidOfReceipt   Receipt?  @relation("ReceiptVoid", fields: [voidOfReceiptId], references: [id])
  voidedBy        Receipt[] @relation("ReceiptVoid")

  voidedAt   DateTime?
  voidReason String?

  @@index([constituentId, taxYear])
  @@map("receipts")
}

// ---------------------------------------------------------------------------
// Sync + audit
// ---------------------------------------------------------------------------

model SyncLog {
  id         String         @id @default(cuid())
  entityType SyncEntityType
  localId    String
  remoteRef  String?

  status        SyncStatus @default(PENDING)
  attempts      Int        @default(0)
  lastAttemptAt DateTime?
  lastError     String?
  // Hash of the payload pushed — refuse to push the same gift twice.
  payloadHash   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([entityType, localId, payloadHash])
  @@index([entityType, localId])
  @@index([status])
  @@map("sync_logs")
}

model AuditLog {
  id         String @id @default(cuid())
  actorId    String
  entityType String
  entityId   String
  action     String

  beforeJson Json?
  afterJson  Json?

  createdAt DateTime @default(now())
  ip        String?

  @@index([entityType, entityId])
  @@index([actorId])
  @@map("audit_logs")
}
