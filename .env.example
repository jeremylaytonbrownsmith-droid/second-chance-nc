DATABASE_URL="postgresql://user:password@localhost:5432/second_chance_nc?schema=public"
# Optional: a direct (non-pooled) connection string, required for Postgres
# LISTEN/NOTIFY (src/app/api/realtime) to work correctly behind a pooler
# like PgBouncer. Neon's Vercel integration sets this automatically.
# Falls back to DATABASE_URL if unset (fine for local dev without a pooler).
DATABASE_URL_UNPOOLED=""

# Stopgap password gate (src/proxy.ts) until real staff auth ships. Gates
# /admin and /api/admin only — guest-facing routes are never gated. Staff
# sign in at /admin/login (branded page, not a browser Basic Auth prompt).
# Leave unset locally to skip the login; set both in production.
ADMIN_USERNAME="secondchance"
ADMIN_PASSWORD=""
