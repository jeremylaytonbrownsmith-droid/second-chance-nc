DATABASE_URL="postgresql://user:password@localhost:5432/second_chance_nc?schema=public"
# Optional: a direct (non-pooled) connection string, required for Postgres
# LISTEN/NOTIFY (src/app/api/realtime) to work correctly behind a pooler
# like PgBouncer. Neon's Vercel integration sets this automatically.
# Falls back to DATABASE_URL if unset (fine for local dev without a pooler).
DATABASE_URL_UNPOOLED=""

# Stopgap password gate (src/proxy.ts) until real staff auth ships. Gates
# /admin and /api/admin only — guest-facing routes are never gated. Staff
# sign in at /admin/login (branded page, not a browser Basic Auth prompt).
# Leave unset locally to skip the login; set both in production.
ADMIN_USERNAME="secondchance"
ADMIN_PASSWORD=""

# Second, lower-privilege shared login — volunteers can check in bidders,
# enter live-auction hammer prices, and (once built) record item pickup.
# Only the admin login can touch FMV, payments, donors, and event
# settings — enforced server-side, not just hidden in the UI. Leave
# VOLUNTEER_PASSWORD unset to disable volunteer login entirely.
VOLUNTEER_USERNAME="volunteer"
VOLUNTEER_PASSWORD=""

# Gates the destructive demo tooling: the "Reset demo data" button and
# /story's auto-reset-on-every-load. Leave unset (or "false") in
# production once real event data exists — set to "true" only on a
# sandbox/demo deployment where wiping and reseeding the demo event on
# every /story visit is desired.
DEMO_MODE="false"

# Receipt emails (src/lib/email) — sent automatically after checkout.
# Leave both unset to use the fake adapter (logs/records only, sends
# nothing real — fine for local dev and every test). Set both to turn on
# real delivery via Resend (https://resend.com); EMAIL_FROM_ADDRESS must
# be a sender address verified on that Resend account.
RESEND_API_KEY=""
EMAIL_FROM_ADDRESS=""

# Absolute base URL used to build links inside emails (the "view this
# receipt online" link). Falls back to http://localhost:3000 if unset —
# fine for local dev, but set this in production or every emailed link
# will point at localhost.
SITE_URL=""
